# Synology persistent data root
DATA_PATH=/volume1/docker/MailGate

TZ=Europe/Brussels
MAILGATE_HOSTNAME=mailgate.local

# MailGate UI version/build shown in the header
MAILGATE_VERSION=0.1.3
MAILGATE_BUILD=20260804.4

# Existing on-premises Exchange SMTP receive connector
EXCHANGE_HOST=192.168.177.13
EXCHANGE_PORT=25

# Fetch interval in seconds
FETCHMAIL_POLL_INTERVAL=60

# MailGate WebUI bootstrap credentials
# UI_PASSWORD is used only until the admin changes the password in the WebUI.
WEB_PORT=8795
UI_USERNAME=admin
UI_PASSWORD=change-me-now

# Synology user/group used by the UI for persistent configuration writes
PUID=1026
PGID=100

# Group ID owning /var/run/docker.sock; required for "Download emails now"
# Check with: stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
