# Synology persistent data root
DATA_PATH=/volume1/docker/MailGate

TZ=Europe/Brussels
MAILGATE_HOSTNAME=mailgate.local

# MailGate UI version/build shown in the header
MAILGATE_VERSION=0.2.0
MAILGATE_BUILD=20260804.5

# Initial on-premises Exchange SMTP target
# These values become the initial defaults in Accounts & Delivery.
EXCHANGE_HOST=192.168.177.13
EXCHANGE_PORT=25

# Initial fetch interval in seconds
FETCHMAIL_POLL_INTERVAL=60

# MailGate WebUI bootstrap credentials
# UI_PASSWORD is used only until the admin changes the password under Security / Profile.
WEB_PORT=8795
UI_USERNAME=admin
UI_PASSWORD=change-me-now

# Synology user/group used by the UI for persistent configuration writes
PUID=1026
PGID=100
